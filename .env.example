# Read access for the deployed server. Safe to expose to the runtime.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key

# Write access, used only by `npm run seed` from your own machine.
# Never set this in the Vercel environment and never commit it.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
